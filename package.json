{
  "name": "future-lawyer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently \"vite\" \"./pocketbase.exe serve --http=127.0.0.1:8090 --dir ./pb_data\"",
    "build": "tsc -b && vite build",
